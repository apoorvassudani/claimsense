# Copy to backend/.env and fill in. NEVER commit the real .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/claimsense

# mock = offline extractor (no key needed) | openai_compat = Groq (OpenAI-compatible API)
LLM_PROVIDER=mock
LLM_API_KEY=
# Groq-hosted OpenAI open-weight model:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=20

# Failure demo: "", timeout, quota, malformed, slow
SIMULATE_FAILURE=
SLOW_CALL_MS=5000
LOG_FILE=logs/claimsense.jsonl
OTEL_CONSOLE=0
CORS_ORIGINS=http://localhost:5173
