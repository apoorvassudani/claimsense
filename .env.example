# Copy to backend/.env and fill in. NEVER commit the real .env.
DATABASE_URL=postgresql+psycopg://claimsense:claimsense@localhost:5432/claimsense

# mock = offline extractor (no key needed) | openai_compat = Groq or Gemini (OpenAI-compatible API)
LLM_PROVIDER=mock
LLM_API_KEY=
# Groq example (check current free-tier models at console.groq.com):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# Gemini example (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_S=20

# Failure demo: "", timeout, quota, malformed, slow
SIMULATE_FAILURE=
SLOW_CALL_MS=5000
LOG_FILE=logs/claimsense.jsonl
OTEL_CONSOLE=0
CORS_ORIGINS=http://localhost:5173
