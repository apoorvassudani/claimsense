# Copy to backend/.env and fill in. NEVER commit the real .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/claimsense

# mock = offline extractor (no key needed) | azure = Azure OpenAI | openai_compat = Groq (OpenAI-compatible API)
LLM_PROVIDER=mock

# Azure OpenAI (LLM_PROVIDER=azure). Endpoint + key: Azure portal > your resource > Keys and Endpoint.
# Deployment names are the names you gave the models in the Foundry portal.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# OCR for scans and photos. auto = Document Intelligence if configured, else gpt vision (needs LLM_PROVIDER=azure).
OCR_PROVIDER=auto
# Azure AI Document Intelligence: resource > Keys and Endpoint. Leave blank to use vision OCR.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=

# Azure AI Search (RAG over policy wording). URL from the resource Overview, admin key from Keys.
# Without these, policy retrieval falls back to local keyword search.
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-NAME.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=policy-clauses
# Leave blank if your chat model is a reasoning model that rejects a custom temperature.
LLM_TEMPERATURE=0

# Groq fallback (LLM_PROVIDER=openai_compat):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=20

# Failure demo: "", timeout, quota, malformed, slow
SIMULATE_FAILURE=
SLOW_CALL_MS=5000
LOG_FILE=logs/claimsense.jsonl
OTEL_CONSOLE=0
CORS_ORIGINS=http://localhost:5173

# Sign-in. AUTH_SECRET signs login tokens: use a long random value, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, everyone is signed out whenever the server restarts.
AUTH_SECRET=
AUTH_TOKEN_MINUTES=480
# Password for the demo accounts intake01 / reviewer01 / admin01 (created when no users exist).
DEMO_PASSWORD=
